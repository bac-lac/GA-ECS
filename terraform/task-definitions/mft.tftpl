[
    {
        "name": "MFT-${MFT_NUMBER}",
        "image": "${ECR_IMAGE}",
        "cpu": 2048,
        "portMappings": [
            {
                "name": "mft-${MFT_NUMBER}-8000-tcp",
                "containerPort": 8000,
                "protocol": "tcp",
                "appProtocol": "http"
            },
            {
                "name": "mft-${MFT_NUMBER}-8001-tcp",
                "containerPort": 8001,
                "protocol": "tcp",
                "appProtocol": "http"
            },
            {
                "name": "mft-${MFT_NUMBER}-8009-tcp",
                "containerPort": 8009,
                "protocol": "tcp",
                "appProtocol": "http"
            },
            {
                "name": "mft-${MFT_NUMBER}-8443-tcp",
                "containerPort": 8443,
                "protocol": "tcp",
                "appProtocol": "http"
            },
            {
                "name": "mft-${MFT_NUMBER}-8022-tcp",
                "containerPort": 8022,
                "protocol": "tcp",
                "appProtocol": "http"
            }
        ],
        "essential": true,
        "environment": [
            {
                "name": "SYSTEM_NAME",
                "value": "MFT${MFT_NUMBER}"
            },
            {
                "name": "MFT_CLUSTER",
                "value": "${MFT_CLUSTER}"
            },
            {
                "name": "ECR_IMAGE",
                "value": "${ECR_IMAGE}"
            },
            {
                "name": "PROFILE_DAMS_ROLE_ARN",
                "value": "${PROFILE_DAMS_ROLE_ARN}"
            },
            {
                "name": "PROFILE_DATAS3_ROLE_ARN",
                "value": "${PROFILE_DATAS3_ROLE_ARN}"
            }
        ],
        "mountPoints": [
            {
                "sourceVolume": "ga_ap_userdata",
                "containerPath": "/opt/Fortra/GoAnywhere/userdata/",
                "readOnly": false
            },
            {
                "sourceVolume": "ga_ap_upgrader",
                "containerPath": "/opt/Fortra/GoAnywhere/upgrader/",
                "readOnly": false
            },
            {
                "sourceVolume": "ga_ap_config",
                "containerPath": "/etc/Fortra/GoAnywhere/config/",
                "readOnly": false
            },
            {
                "sourceVolume": "ga_ap_tomcatserver",
                "containerPath": "/etc/Fortra/GoAnywhere/tomcat/",
                "readOnly": false
            },
            {
                "sourceVolume": "ga_ap_tomcatlog",
                "containerPath": "/opt/Fortra/GoAnywhere/tomcat/logs/",
                "readOnly": false
            },
            {
                "sourceVolume": "ga_ap_ghttpsroot",
                "containerPath": "/opt/Fortra/GoAnywhere/ghttpsroot/custom/",
                "readOnly": false
            }
        ],
        "volumesFrom": [],
        "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
                "awslogs-create-group": "true",
                "awslogs-group": "/ecs/ga-td",
                "awslogs-region": "ca-central-1",
                "awslogs-stream-prefix": "ecs"
            }
        },
        "healthCheck": {
            "command": [
                "CMD-SHELL",
                "curl -f http://localhost:8000/ || exit 1"
            ],
            "interval": 30,
            "timeout": 5,
            "retries": 3,
            "startPeriod": 120
        },
        "systemControls": []
    }
]